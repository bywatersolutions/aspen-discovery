<?xml version="1.0"?>
<ruleset name="Aspen Discovery PHPMD Ruleset"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0
                     http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="
                     http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        Ruleset For Aspen Discovery Development
    </description>

    <!-- Using all rules in unusedcode -->
    <rule ref="rulesets/unusedcode.xml" />

    <!-- Using subset of rules from Clean Code -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="BooleanArgumentFlag" />
        <exclude name="StaticAccess" />
        <exclude name="MissingImport" />
        <exclude name="ElseExpression" />
    </rule>

    <!-- Using subset of rules from CodeSize -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity" />
    <rule ref="rulesets/codesize.xml/NPathComplexity" />
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength" />
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList" />

    <!-- Design Rules -->
    <rule ref="rulesets/design.xml/CountInLoopExpression" />
    <rule ref="rulesets/design.xml/EmptyCatchBlock" />
    <rule ref="rulesets/design.xml/DevelopmentCodeFragment" />
</ruleset>